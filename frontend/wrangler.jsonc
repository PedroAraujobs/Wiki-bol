{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wiki-bol",
  "compatibility_date": "2026-06-12",
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_ORIGIN": "https://wiki-bol-api.onrender.com"
  }
}
